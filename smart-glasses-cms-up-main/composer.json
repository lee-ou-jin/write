{
    "name": "amuz/cms-up",
    "type": "project",
    "description": "라라벨과 노바, JetStream 을 기반으로 한 기본 컴포넌트들이 준비된 CMS 입니다.",
    "keywords": [
        "laravel",
        "framework",
        "nova",
        "cms",
        "amuz"
    ],
    "license": "MIT",
    "repositories": {
        "xiso/vimeo-field": {
            "type": "vcs",
            "url": "https://github.com/amuzcorp/vimeo-field"
        },
        "0": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        "1": {
            "type": "path",
            "url": "./nova-components/ChatCard"
        },
        "2": {
            "type": "path",
            "url": "./nova-components/ChatCard"
        },
        "3": {
            "type": "path",
            "url": "./nova-components/LiveCard"
        },
        "4": {
            "type": "path",
            "url": "./nova-components/TaskLogModal"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "badinansoft/nova-language-switch": "^1.2",
        "bolechen/nova-activitylog": "^0.4.1",
        "codenco-dev/nova-grid-system": "^2.0",
        "composer/installers": "^2.2",
        "doctrine/dbal": "^3.0",
        "ebess/advanced-nova-media-library": "^4.1",
        "eminiarts/nova-tabs": "^2.2",
        "giggsey/libphonenumber-for-php": "^8.13",
        "guzzlehttp/guzzle": "^7.2",
        "hexadog/laravel-themes-manager": "^1.11",
        "inertiajs/inertia-laravel": "^0.6.8",
        "interaction-design-foundation/nova-html-card": "^3.1",
        "jerry/chat-card": "@dev",
        "jerry/live-card": "@dev",
        "jerry/task-log-modal": "@dev",
        "kreait/laravel-firebase": "^5.10",
        "laravel/framework": "^10.10",
        "laravel/jetstream": "^4.1",
        "laravel/nova": "^4.0",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^3.3",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^2.8",
        "lednerb/nova-action-button-selectors": "^2.0",
        "mahi/spatie-tags-nova-filter": "^0.0.8",
        "mostafaznv/nova-ckeditor": "*",
        "oomphinc/composer-installers-extender": "*",
        "outl1ne/nova-settings": "^5.2",
        "outl1ne/nova-translatable": "^2.2",
        "pixelcreation/nova-field-sortable": "^3.2",
        "predis/predis": "^2.2",
        "pusher/pusher-php-server": "^7.2",
        "rappasoft/laravel-authentication-log": "^3.0",
        "rinvex/laravel-categories": "^7.1",
        "sereny/nova-permissions": "^1.4",
        "socialiteproviders/apple": "^5.6",
        "socialiteproviders/facebook": "^4.1",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/kakao": "^4.2",
        "socialiteproviders/naver": "^4.1",
        "spatie/laravel-analytics": "^4.1",
        "spatie/laravel-sluggable": "^3.5",
        "spatie/laravel-translatable": "^6.5",
        "spatie/nova-tags-field": "^4.0",
        "tightenco/nova-google-analytics": "^3.0",
        "tightenco/ziggy": "^1.0",
        "tomatophp/laravel-agora": "^1.0",
        "torann/geoip": "^3.0",
        "trin4ik/nova-switcher": "^0.4.0",
        "wikimedia/composer-merge-plugin": "^2.1",
        "wyndow/fuzzywuzzy": "^0.6.0",
        "xiso/vimeo-field": "dev-main",
        "ziffmedia/nova-select-plus": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "AmuzThemes\\": "amuz-themes/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/laravel/framework/src/Illuminate/Support/Str.php",
            "vendor/hexadog/laravel-themes-manager/src/Console/Generators/MakeTheme.php"
        ],
        "files": [
            "app/Services/Str.php",
            "app/Services/MakeTheme.php",
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "installer-types": [
            "amuz-package",
            "amuz-theme"
        ],
        "installer-paths": {
            "amuz-packages/{$name}": [
                "type:amuz-package"
            ],
            "amuz-themes/{$vendor}/{$name}": [
                "type:amuz-theme"
            ]
        },
        "merge-plugin": {
            "include": [
                "amuz-packages/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": true,
            "merge-scripts": true
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "wikimedia/composer-merge-plugin": true,
            "hexadog/laravel-theme-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
