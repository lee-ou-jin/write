let mix = require('laravel-mix')
let path = require('path')
require('./nova.mix')

mix
  .setPublicPath('dist')
  .js('src/Nova/{{uriKey}}.js', 'js')
  .vue({version: 3})
  .alias(
      {
          "@laravel-nova": path.join(
              __dirname,
              "../../vendor/laravel/nova/resources/js/mixins/packages.js"
          ),
          '@': path.join(__dirname, 'src/Nova'),
      }
  )
  .sass('src/Nova/{{uriKey}}.scss', 'css')
  .nova('{{vendor}}/{{uriKey}}')
  .version()
